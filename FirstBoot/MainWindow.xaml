<Window x:Class="FirstBoot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FirstBoot"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" Padding="10">
            <StackPanel>
                <TextBlock Text="CATEGORIES" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                <Button Content="🎮 Gaming" Tag="Gaming" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
                <Button Content="🛠 Utilities" Tag="Utilities" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
                <Button Content="💻 Development" Tag="Development" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
                <Button Content="🌐 Browsers" Tag="Browsers" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
                <Button Content="🎵 Media" Tag="Media" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
                <Button Content="🔧 Hardware / System" Tag="Hardware / System" Click="CategoryButton_Click" Height="40" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" Padding="10">
            <StackPanel x:Name="ApplicationsPanel">
                <TextBlock Text="APPLICATIONS" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="Select a category" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel x:Name="InformationPanel">
                <TextBlock Text="INFORMATION" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="Select an application" Foreground="Gray"/>
            </StackPanel>
        </Border>

		<Border Grid.Row="1"
        Grid.ColumnSpan="3"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5"
        Margin="0,10,0,0"
        Padding="10">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Controls -->
				<DockPanel Grid.Row="0">
					<Button x:Name="CancelInstallationButton"
							Content="Cancel"
							Click="CancelInstallationButton_Click"
							IsEnabled="False"
							Padding="14,6"
							Margin="0,0,8,0"
							DockPanel.Dock="Right"/>

					<Button x:Name="InstallSelectedButton"
							Content="Install selected applications"
							Click="InstallSelectedButton_Click"
							IsEnabled="False"
							Padding="14,6"
							DockPanel.Dock="Right"/>

					<TextBlock x:Name="SelectedApplicationsText"
							   Text="0 applications selected"
							   VerticalAlignment="Center"
							   Margin="0,0,15,0"/>

					<TextBlock x:Name="InstallationStatusText"
							   VerticalAlignment="Center"
							   Foreground="Gray"/>
				</DockPanel>

				<!-- Installation progress -->
				<ProgressBar x:Name="InstallationProgressBar"
							 Grid.Row="1"
							 Minimum="0"
							 Maximum="100"
							 Value="0"
							 Height="8"
							 Margin="0,10,0,0"/>
			</Grid>
		</Border>
    </Grid>
</Window>
